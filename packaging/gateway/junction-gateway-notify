#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# keepalived notify: record every change of who holds the floating gateway address.
# Junction shows /run/gateway-state and /var/log/gateway-failover.log in its UI.
# Args from keepalived: TYPE NAME STATE PRIORITY
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
echo "$now gateway $3" >> /var/log/gateway-failover.log
echo "$3 $now" > /run/gateway-state
