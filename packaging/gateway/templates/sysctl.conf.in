# Junction gateway, written by setup.sh (junction-tproxy also sets these at start).
net.ipv4.ip_forward = 1
# Never tell devices to bypass the gateway and talk to the router directly.
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.@LAN_IF@.send_redirects = 0
