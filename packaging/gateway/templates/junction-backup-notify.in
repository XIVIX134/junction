#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# keepalived notify on the BACKUP box for Junction's floating gateway @VIP_ADDR@.
# MASTER = the Junction box is down: route + NAT the LAN straight to the internet.
# Anything else = give the address back and stop routing.
# Args from keepalived: TYPE NAME STATE PRIORITY
IF=eth0   # the backup machine's LAN interface
LAN=@LAN_CIDR@
NAT="POSTROUTING -s $LAN ! -d $LAN -o $IF -j MASQUERADE"
case "$3" in
MASTER)
    sysctl -q -w net.ipv4.ip_forward=1
    sysctl -q -w net.ipv4.conf.all.send_redirects=0 "net.ipv4.conf.$IF.send_redirects=0"
    # shellcheck disable=SC2086
    iptables -t nat -C $NAT 2>/dev/null || iptables -t nat -A $NAT
    ;;
*)
    # shellcheck disable=SC2086
    iptables -t nat -D $NAT 2>/dev/null
    # Only turn forwarding off if this machine wasn't a router before (edit if it was).
    sysctl -q -w net.ipv4.ip_forward=0
    ;;
esac
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) backup $3" >> /var/log/gateway-failover.log
