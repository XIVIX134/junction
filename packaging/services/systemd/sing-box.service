[Unit]
Description=sing-box (Junction gateway proxy)
Documentation=https://sing-box.sagernet.org
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/sing-box check -c /etc/sing-box/config.json
ExecStartPre=/bin/mkdir -p /var/lib/sing-box
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
ExecReload=/bin/kill -HUP $MAINPID
# Fail open at once: unhook TPROXY whenever sing-box stops or crashes
# (junction-tproxy hooks it back in when sing-box answers again).
ExecStopPost=-/usr/local/sbin/junction-tproxy disable
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
