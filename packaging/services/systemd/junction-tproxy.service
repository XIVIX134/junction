[Unit]
Description=Junction TPROXY rules (only while sing-box is healthy) + NAT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/junction-tproxy run
ExecStopPost=-/usr/local/sbin/junction-tproxy disable
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
